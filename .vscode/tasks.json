{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/src/NtbEvent.Api/NtbEvent.Api.csproj",
                "-c",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "clean-backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/backend/src/NtbEvent.Api/NtbEvent.Api.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch-backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/backend/src/NtbEvent.Api/NtbEvent.Api.csproj"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Now listening on:.*",
                    "endsPattern": "^.*Now listening on:.*"
                }
            }
        }
    ]
}
